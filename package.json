{
    "name": "winboat",
    "version": "0.8.7",
    "description": "Windows for Penguins",
    "type": "module",
    "main": "main/main.js",
    "engines": {
        "node": ">=23.6.0"
    },
    "scripts": {
        "dev": "node scripts/dev-server.ts",
        "build-guest-server": "bash build-guest-server.sh",
        "build:linux-gs": "bash build-guest-server.sh && node scripts/build.ts && npm run build:helios:viewer && electron-builder --linux",
        "build:helios:viewer": "bash native/helios-viewer/build.sh",
        "test:virgl": "tsx --test tests/virgl.test.ts",
        "test:packaging": "node --test tests/packaging.test.cjs",
        "test:atlas": "tsx --test tests/atlas.test.ts",
        "test:atlas:iso": "bash tests/atlas-iso.test.sh",
        "test:atlas:windows": "pwsh -NoProfile -File tests/atlas-windows.test.ps1 && pwsh -NoProfile -File tests/atlas-recovery.test.ps1 && pwsh -NoProfile -File tests/atlas-observer.test.ps1 && pwsh -NoProfile -File tests/atlas-helios-handoff.test.ps1 && pwsh -NoProfile -File tests/atlas-acl.test.ps1 && pwsh -NoProfile -File tests/atlas-ui.test.ps1 && pwsh -NoProfile -File tests/atlas-session-launcher.test.ps1",
        "build:helios:host": "node scripts/helios/build-host.ts",
        "helios:stage": "node scripts/helios/stage.ts",
        "helios:adopt-installer": "node scripts/helios/adopt-installer.ts",
        "test:helios": "tsx --test tests/native-desktop-environment.test.ts tests/interval.test.ts tests/helios.test.ts tests/helios-display.test.ts tests/helios-viewer.test.ts tests/specs.test.ts tests/host-environment.test.ts tests/helios-installer.test.ts tests/vm-identity.test.ts tests/install-container.test.ts",
        "build": "node scripts/build.ts",
        "helios:fetch-installer": "node scripts/helios/fetch-installer.ts",
        "test:helios:qemu-dbus": "python3 tests/helios-qemu-dbus.py",
        "test:helios:host": "node scripts/helios/smoke-host.ts",
        "test:vm-identity:qemu": "node scripts/helios/smoke-identity.ts",
        "test:helios:viewer": "bash scripts/helios/smoke-viewer.sh",
        "test:helios:windows": "pwsh -NoProfile -File tests/guest-update-provisioning.test.ps1 && pwsh -NoProfile -File tests/vcredist-provisioning.test.ps1 && pwsh -NoProfile -File tests/display-adapters.test.ps1 && pwsh -NoProfile -File tests/helios-provisioning.test.ps1 && pwsh -NoProfile -File tests/helios-windows.test.ps1",
        "test:shared-folders": "tsx --test tests/shared-folders.test.ts"
    },
    "repository": "https://github.com/TibixDev/winboat",
    "author": {
        "name": "TibixDev",
        "url": "https://github.com/TibixDev",
        "email": "staff@winboat.app"
    },
    "devDependencies": {
        "@types/json-to-pretty-yaml": "^1.2.1",
        "@types/node-fetch": "^2.6.12",
        "@types/screenshot-desktop": "^1.12.3",
        "@types/turndown": "^5.0.5",
        "@vitejs/plugin-vue": "^5.2.1",
        "autoprefixer": "^10.4.20",
        "chalk": "^4.1.2",
        "chokidar": "^3.6.0",
        "electron": "^35.1.5",
        "electron-builder": "^26.0.12",
        "mock-fs": "^5.5.0",
        "postcss": "^8.5.1",
        "tailwindcss": "^3.4.17",
        "typescript": "~5.6.3",
        "tsx": "^4.19.2",
        "vite": "^6.0.7",
        "vue-tsc": "^2.2.0"
    },
    "dependencies": {
        "@electron/remote": "^2.1.2",
        "@iconify/vue": "^4.3.0",
        "@vueuse/core": "^13.1.0",
        "@vueuse/motion": "^2.2.6",
        "apexcharts": "^4.5.0",
        "check-disk-space": "^3.4.0",
        "consola": "^3.4.2",
        "electron-store": "^11.0.0",
        "form-data": "^4.0.4",
        "jimp": "^1.6.0",
        "json-to-pretty-yaml": "^1.2.2",
        "marked": "^15.0.6",
        "nanoevents": "^9.1.0",
        "node-fetch": "2",
        "path-browserify": "^1.0.1",
        "turndown": "^7.2.0",
        "usb": "^2.16.0",
        "vue": "^3.5.13",
        "vue-router": "^4.5.0",
        "vue3-apexcharts": "^1.8.0",
        "xel": "^0.33.7",
        "yaml": "^2.7.1"
    }
}
