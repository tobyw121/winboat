# Keep the checksum-locked upstream snapshot byte-identical on Windows too.
helios/upstream/** -text
# Preserve the exact bytes of checksum-locked third-party engine patches.
helios/compatibility/patches/*.patch -text whitespace=-blank-at-eol
# The standalone recovery script must match its embedded installer copy.
scripts/helios/Clear-HeliosDriverStore.ps1 -text
guest_server/scripts/Clear-HeliosDriverStore.ps1 -text
helios/source.lock.json text eol=lf
helios/stack.lock.json text eol=lf
resources/helios/HeliosSetup.exe binary
resources/helios/helios-build.json text eol=lf
resources/helios-*/HeliosSetup.exe binary
resources/helios-*/helios-build.json text eol=lf
# The CI receipt hashes this patch record byte for byte, including line endings.
resources/helios-*/compatibility-patches.json -text whitespace=cr-at-eol
resources/helios-*/SHA256SUMS text eol=lf
resources/atlas/AtlasPlaybook.apbx binary
tests/fixtures/hivex/minimal.hive binary

# Unified diffs encode empty context lines as a single space.
helios/upstream/ci/patches/mesa/*.patch whitespace=-blank-at-eol
