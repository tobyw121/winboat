+/* Query this worker's live driver budget, not a temporary probe process. */
+static bool
+vkr_vm_budget(struct vkr_physical_device *physical, uint64_t bytes, bool release)
+{
+   if (!bytes || !getenv("HELIOS_VRAM_BUDGET_FILE")) return true;
+   if (release) {
+      bool ok = helios_vram_change(physical->id_properties.deviceUUID, 0, 0, bytes, true, NULL, NULL);
+      if (!ok) vkr_log("vram-budget release accounting failed");
+      return ok;
+   }
+   VkPhysicalDeviceMemoryBudgetPropertiesEXT budget = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MEMORY_BUDGET_PROPERTIES_EXT };
+   bool supported = physical->EXT_memory_budget;
+   VkPhysicalDeviceMemoryProperties2 props = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MEMORY_PROPERTIES_2,
+      .pNext = supported ? &budget : NULL };
+   physical->proc_table.GetPhysicalDeviceMemoryProperties2(physical->base.handle.physical_device, &props);
+   uint64_t total = 0, available = 0;
+   for (uint32_t i = 0; i < props.memoryProperties.memoryHeapCount; i++) {
+      if (!(props.memoryProperties.memoryHeaps[i].flags & VK_MEMORY_HEAP_DEVICE_LOCAL_BIT)) continue;
+      uint64_t size = props.memoryProperties.memoryHeaps[i].size;
+      uint64_t allowance = supported ? MIN2(budget.heapBudget[i], size) : size;
+      if (UINT64_MAX-total < size || UINT64_MAX-available < allowance) return false;
+      total += size; available += allowance;
+   }
+   uint64_t used = 0, cap = 0;
+   bool ok = helios_vram_change(physical->id_properties.deviceUUID, total, available, bytes, release, &used, &cap);
+   if (!ok) vkr_log("vram-budget refused: release=%d requested=%" PRIu64 " used=%" PRIu64 " cap=%" PRIu64,
+                   release, bytes, used, cap);
+   return ok;
+}
