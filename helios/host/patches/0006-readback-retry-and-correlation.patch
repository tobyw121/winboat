+/* Cache only one-fd identities. Never guess a multi-plane layout. A changed
+ * shape or new kernel object starts fresh; bounded retained fds prevent ABA. */
+static HeliosImportFailure *helios_import_failure(
+    HeliosVulkanReadbackCache *cache, QemuDmaBuf *dmabuf, bool optimal)
+{
+    int nfds, noffsets, nstrides;
+    const uint32_t *offsets = qemu_dmabuf_get_offsets(dmabuf, &noffsets);
+    const uint32_t *strides = qemu_dmabuf_get_strides(dmabuf, &nstrides);
+    const int *fds = qemu_dmabuf_get_fds(dmabuf, &nfds);
+    struct stat st;
+    if (noffsets != 1 || nstrides != 1) {
+        return NULL;
+    }
+    uint64_t shape[] = {qemu_dmabuf_get_width(dmabuf),
+        qemu_dmabuf_get_height(dmabuf), qemu_dmabuf_get_backing_width(dmabuf),
+        qemu_dmabuf_get_backing_height(dmabuf), qemu_dmabuf_get_x(dmabuf),
+        qemu_dmabuf_get_y(dmabuf), qemu_dmabuf_get_fourcc(dmabuf),
+        qemu_dmabuf_get_modifier(dmabuf), qemu_dmabuf_get_allocation_size(dmabuf),
+        qemu_dmabuf_get_source_id(dmabuf), optimal,
+        qemu_dmabuf_get_num_planes(dmabuf), offsets[0], strides[0]};
+    if (nfds != 1 || fds[0] < 0 || fstat(fds[0], &st)) {
+        return NULL;
+    }
+    for (size_t i = 0; i < ARRAY_SIZE(cache->failures); i++) {
+        HeliosImportFailure *f = &cache->failures[i];
+        if (f->fd >= 0 && f->dev == st.st_dev && f->ino == st.st_ino &&
+            !memcmp(f->shape, shape, sizeof(shape))) {
+            return f;
+        }
+    }
+    int held = fcntl(fds[0], F_DUPFD_CLOEXEC, 0);
+    if (held < 0) {
+        return NULL;
+    }
+    HeliosImportFailure *f = &cache->failures[
+        cache->failed_next++ % ARRAY_SIZE(cache->failures)];
+    if (f->fd >= 0) {
+        close(f->fd);
+    }
+    *f = (HeliosImportFailure){.fd = held, .dev = st.st_dev, .ino = st.st_ino};
+    memcpy(f->shape, shape, sizeof(shape));
+    return f;
 }

