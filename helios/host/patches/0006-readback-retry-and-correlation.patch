--- /dev/null
+++ b/ui/helios-retry.h
@@ -0,0 +1,15 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef HELIOS_RETRY_H
+#define HELIOS_RETRY_H
+#include <stdint.h>
+#include <stdbool.h>
+typedef struct HeliosRetry { int64_t next_ns; unsigned attempts; } HeliosRetry;
+static inline bool helios_retry_ready(const HeliosRetry *r, int64_t now)
+{ return now >= r->next_ns; }
+static inline void helios_retry_failed(HeliosRetry *r, int64_t now)
+{
+    unsigned shift = r->attempts < 5 ? r->attempts : 5;
+    if (r->attempts < 6) { r->attempts++; }
+    r->next_ns = now + (INT64_C(250000000) << shift);
+}
+#endif
