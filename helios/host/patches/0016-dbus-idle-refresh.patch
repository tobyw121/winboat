+/* Event-driven damage wakes the normal rate; quiet scans back off without
+ * copying unchanged pixels. A blocked source never grows a frame queue. */
+static void dbus_helios_refresh_activity(DBusDisplayListener *ddl, bool dirty)
+{
+    if (!g_strcmp0(g_getenv("HELIOS_IDLE_REFRESH"), "0")) {
+        dirty = true;
+    }
+    if (dirty) {
+        ddl->helios_quiet_refreshes = 0;
+        if (ddl->helios_active_interval) {
+            qemu_console_listener_set_refresh(&ddl->dcl, ddl->helios_active_interval);
+            ddl->helios_active_interval = 0;
+        }
+    } else if (ddl->helios_quiet_refreshes < 16) {
+        ddl->helios_quiet_refreshes++;
+        if (ddl->helios_quiet_refreshes == 16 && ddl->dcl.update_interval < 100) {
+            ddl->helios_active_interval = ddl->dcl.update_interval ?
+                ddl->dcl.update_interval : GUI_REFRESH_INTERVAL_DEFAULT;
+            qemu_console_listener_set_refresh(&ddl->dcl, 100);
+        }
+    }
+}
