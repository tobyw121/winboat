diff --git a/ui/helios-cache-policy.h b/ui/helios-cache-policy.h
new file mode 100644
index 0000000..dc00849
--- /dev/null
+++ b/ui/helios-cache-policy.h
@@ -0,0 +1,17 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef HELIOS_CACHE_POLICY_H
+#define HELIOS_CACHE_POLICY_H
+/* Retained imports, not a byte budget. Invalid input never expands the cache. */
+static inline unsigned helios_cache_entries(const char *value)
+{
+    if (!value || !*value) return 8;
+    if (value[1]) return 0;
+    switch (value[0]) {
+    case '1': return 1;
+    case '2': return 2;
+    case '4': return 4;
+    case '8': return 8;
+    default: return 0;
+    }
+}
+#endif
