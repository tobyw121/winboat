+/* Charge only owned DEVICE_LOCAL memory; imported producer memory was charged
+ * by Venus. The shared ledger spans all worker processes in this VM launch. */
+static VkResult helios_allocate_vm_owned(HeliosVulkanReadback *rb,
+    const VkMemoryAllocateInfo *info, VkDeviceMemory *memory, uint64_t *owned, uint64_t *vram)
+{
+    VkPhysicalDeviceIDProperties id = { .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_ID_PROPERTIES };
+    VkPhysicalDeviceProperties2 props = { .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2, .pNext = &id };
+    vkGetPhysicalDeviceProperties2(rb->physical_device, &props);
+    memcpy(rb->vram_uuid, id.deviceUUID, VK_UUID_SIZE);
+    uint32_t count = 0; bool supports_budget = false;
+    if (vkEnumerateDeviceExtensionProperties(rb->physical_device, NULL, &count, NULL) != VK_SUCCESS || count > 1024) return VK_ERROR_INITIALIZATION_FAILED;
+    VkExtensionProperties *extensions = g_new0(VkExtensionProperties, count);
+    VkResult query = vkEnumerateDeviceExtensionProperties(rb->physical_device, NULL, &count, extensions);
+    if (query == VK_SUCCESS) for (uint32_t i = 0; i < count; i++) supports_budget |= !strcmp(extensions[i].extensionName, VK_EXT_MEMORY_BUDGET_EXTENSION_NAME);
+    g_free(extensions);
+    if (query != VK_SUCCESS) return query;
+    VkPhysicalDeviceMemoryBudgetPropertiesEXT budget = { .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MEMORY_BUDGET_PROPERTIES_EXT };
+    VkPhysicalDeviceMemoryProperties2 mem = { .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MEMORY_PROPERTIES_2, .pNext = supports_budget ? &budget : NULL };
+    vkGetPhysicalDeviceMemoryProperties2(rb->physical_device, &mem);
+    if (info->memoryTypeIndex >= mem.memoryProperties.memoryTypeCount) return VK_ERROR_INITIALIZATION_FAILED;
+    uint64_t bytes = (mem.memoryProperties.memoryTypes[info->memoryTypeIndex].propertyFlags & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT) ? info->allocationSize : 0;
+    uint64_t total = 0, available = 0, used = 0, cap = 0;
+    for (uint32_t i = 0; i < mem.memoryProperties.memoryHeapCount; i++) {
+        if (!(mem.memoryProperties.memoryHeaps[i].flags & VK_MEMORY_HEAP_DEVICE_LOCAL_BIT)) continue;
+        uint64_t size = mem.memoryProperties.memoryHeaps[i].size;
+        uint64_t allowance = supports_budget ? MIN(budget.heapBudget[i], size) : size;
+        if (UINT64_MAX-total < size || UINT64_MAX-available < allowance) return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+        total += size; available += allowance;
+    }
+    if (bytes && !helios_vram_change(rb->vram_uuid, total, available, bytes, false, &used, &cap)) {
+        error_report("vram-budget refused: release=0 requested=%" PRIu64 " used=%" PRIu64 " cap=%" PRIu64, bytes, used, cap);
+        return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+    }
+    VkResult result = helios_allocate_owned(rb->device, info, memory, owned);
+    if (result == VK_SUCCESS) *vram = bytes;
+    else if (bytes) helios_vram_change(rb->vram_uuid, 0, 0, bytes, true, NULL, NULL);
+    return result;
+}
