+#if defined(CONFIG_OPENGL) && defined(CONFIG_GBM) && defined(CONFIG_LINUX)
+static void dbus_helios_readback_clear(DBusDisplayListener *ddl)
+{
+    if (ddl->vk_cache) {
+        helios_vulkan_readback_cache_deactivate(ddl->vk_cache,
+                                               ddl->active_dmabuf);
+    }
+    ddl->vk_readback = NULL;
+    g_clear_pointer(&ddl->vk_surface, qemu_free_displaysurface);
+    ddl->vk_announced = false;
+    ddl->vk_failed = false;
+}
+
+static bool dbus_helios_readback_select(DBusDisplayListener *ddl,
+                                       QemuDmaBuf *dmabuf)
+{
+    bool was_readback = ddl->vk_readback != NULL;
+    uint32_t width = qemu_dmabuf_get_width(dmabuf);
+    uint32_t height = qemu_dmabuf_get_height(dmabuf);
+    g_auto(DBusGLContextScope) scope = { 0 };
+
+    if (ddl->vk_cache) {
+        helios_vulkan_readback_cache_deactivate(ddl->vk_cache,
+                                               ddl->active_dmabuf);
+    }
+    ddl->vk_readback = NULL;
+    /* Native Venus primaries may be OPTIMAL without a DRM modifier. EGL's
+     * successful import does not establish that layout. Reuse the same native
+     * Vulkan importer as egl-headless: it accepts this shape only when the
+     * driver memory requirement exactly matches the original blob size.
+     * Never reinterpret MOD_INVALID as LINEAR or mmap opaque DRM storage. */
+    if (qemu_dmabuf_get_modifier(dmabuf) == DRM_FORMAT_MOD_INVALID &&
+        qemu_dmabuf_get_allocation_size(dmabuf) &&
+        dbus_gl_context_bind(&scope)) {
+        if (!ddl->vk_cache) {
+            ddl->vk_cache = helios_vulkan_readback_cache_new();
+        }
+        ddl->vk_readback = helios_vulkan_readback_cache_activate(
+            ddl->vk_cache, dmabuf, true);
+    }
+    if (!ddl->vk_readback) {
+        dbus_helios_readback_clear(ddl);
+        return false;
+    }
+    if (!ddl->vk_surface || (uint32_t)surface_width(ddl->vk_surface) != width ||
+        (uint32_t)surface_height(ddl->vk_surface) != height) {
+        g_clear_pointer(&ddl->vk_surface, qemu_free_displaysurface);
+        ddl->vk_surface = qemu_create_displaysurface(width, height);
+        ddl->vk_announced = false;
+    }
+    if (!was_readback) {
+        ddl->vk_announced = false;
+        error_report("dbus: using validated OPTIMAL Vulkan readback %ux%u",
+                     width, height);
+    }
+    ddl->vk_failed = false;
+    return true;
+}
+
+static void dbus_helios_frame_done(GObject *source, GAsyncResult *result,
+                                  gpointer opaque)
+{
+    DBusDisplayListener *ddl = opaque;
+    g_autoptr(GError) err = NULL;
+    g_autoptr(GVariant) reply = g_dbus_proxy_call_finish(
+        G_DBUS_PROXY(source), result, &err);
+
+    if (!reply) {
+        error_report("dbus: failed to send Helios frame: %s", err->message);
+        ddl->vk_announced = false;
+    }
+    qemu_console_hw_gl_block(ddl->dcl.con, false);
+    g_object_unref(ddl);
+}
+
+static bool dbus_helios_readback_update(DBusDisplayListener *ddl)
+{
+    GVariant *data;
+    GBytes *pixels;
+    uint32_t width, height, stride;
+    size_t bytes;
+
+    if (!ddl->vk_readback) {
+        return false;
+    }
+    width = surface_width(ddl->vk_surface);
+    height = surface_height(ddl->vk_surface);
+    stride = surface_stride(ddl->vk_surface);
+    /* Complete the Vulkan external-ownership round trip before acknowledging
+     * the producer. An unsuccessful capture must never publish stale pixels
+     * or fall through to UpdateDMABUF without a DMA-BUF baseline. */
+    if (!helios_vulkan_readback_flush(ddl->vk_readback, ddl->vk_surface,
+                                      0, 0, width, height)) {
+        if (!ddl->vk_failed) {
+            error_report("dbus: OPTIMAL Vulkan readback failed; keeping last frame");
+        }
+        ddl->vk_failed = true;
+        return true;
+    }
+    ddl->vk_failed = false;
+    bytes = (size_t)stride * height;
+    /* GDBus serializes asynchronously. Own an immutable pixel snapshot rather
+     * than a reference to the reusable staging surface of the next frame. */
+    pixels = g_bytes_new(surface_data(ddl->vk_surface), bytes);
+    data = g_variant_new_from_bytes(G_VARIANT_TYPE("ay"), pixels, true);
+    g_bytes_unref(pixels);
+    qemu_console_hw_gl_block(ddl->dcl.con, true);
+    if (!ddl->vk_announced) {
+        ddl_discard_display_messages(ddl);
+        ddl->vk_announced = true;
+        qemu_dbus_display1_listener_call_scanout(ddl->proxy, width, height,
+            stride, surface_format(ddl->vk_surface), data,
+            G_DBUS_CALL_FLAGS_NONE, DBUS_DEFAULT_TIMEOUT, NULL,
+            dbus_helios_frame_done, g_object_ref(ddl));
+    } else {
+        qemu_dbus_display1_listener_call_update(ddl->proxy, 0, 0, width, height,
+            stride, surface_format(ddl->vk_surface), data,
+            G_DBUS_CALL_FLAGS_NONE, DBUS_DEFAULT_TIMEOUT, NULL,
+            dbus_helios_frame_done, g_object_ref(ddl));
+    }
+    return true;
+}
+#endif
