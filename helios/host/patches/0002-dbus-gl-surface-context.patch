--- /dev/null
+++ b/ui/dbus-gl-context.h
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: MIT
+ * The renderer may release/change EGL context between display callbacks.
+ * Bind the display's shared context and restore the caller, including NONE.
+ */
+#ifndef QEMU_DBUS_GL_CONTEXT_H
+#define QEMU_DBUS_GL_CONTEXT_H
+
+#include "ui/egl-helpers.h"
+#include "ui/egl-context.h"
+
+typedef struct DBusGLContextScope {
+    EGLDisplay display;
+    EGLContext context;
+    EGLSurface draw, read;
+    bool saved;
+} DBusGLContextScope;
+
+static inline void dbus_gl_context_restore(DBusGLContextScope *scope)
+{
+    if (scope->saved &&
+        !eglMakeCurrent(scope->display != EGL_NO_DISPLAY ?
+                        scope->display : qemu_egl_display,
+                        scope->draw, scope->read, scope->context)) {
+        error_report("dbus: restoring EGL context failed: %s",
+                     qemu_egl_get_error_string());
+    }
+}
+G_DEFINE_AUTO_CLEANUP_CLEAR_FUNC(DBusGLContextScope, dbus_gl_context_restore)
+
+static inline bool dbus_gl_context_bind(DBusGLContextScope *scope)
+{
+    scope->display = eglGetCurrentDisplay();
+    scope->context = eglGetCurrentContext();
+    scope->draw = eglGetCurrentSurface(EGL_DRAW);
+    scope->read = eglGetCurrentSurface(EGL_READ);
+    if (qemu_egl_make_context_current(NULL, qemu_egl_rn_ctx) < 0) {
+        return false;
+    }
+    scope->saved = true;
+    return true;
+}
+#endif
