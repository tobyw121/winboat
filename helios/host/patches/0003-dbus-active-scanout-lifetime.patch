+
+    if (ddl->active_dmabuf && ddl->active_dmabuf == dmabuf) {
+        dbus_scanout_disable(dcl);
+    }
 }
 #endif /* GBM */
 
@@ -888,6 +906,10 @@ static void dbus_gl_gfx_switch(DisplayChangeListener *dcl,
