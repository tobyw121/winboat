+/* This fallback reads only an explicitly described, successfully EGL-imported
+ * image. An unknown modifier/undersized native OPTIMAL blob is never guessed.
+ * Source reads finish before the listener ACK releases the producer. */
+static bool dbus_helios_copy_capture(DBusDisplayListener *ddl)
+{
+    QemuDmaBuf *buf = ddl->active_dmabuf;
+    egl_fb src = EGL_FB_INIT, dst = EGL_FB_INIT;
+    g_auto(DBusGLContextScope) scope = { 0 };
+    GLint previous_read, previous_draw, previous_texture, viewport[4];
+    bool ok;
+    if (!buf || qemu_dmabuf_get_modifier(buf) == DRM_FORMAT_MOD_INVALID ||
+        !qemu_dmabuf_get_width(buf) || !qemu_dmabuf_get_height(buf) ||
+        qemu_dmabuf_get_num_planes(buf) != 1 ||
+        qemu_dmabuf_get_width(buf) > 8192 || qemu_dmabuf_get_height(buf) > 8192 ||
+        (uint64_t)qemu_dmabuf_get_width(buf) * qemu_dmabuf_get_height(buf) > 33554432 ||
+        (uint64_t)qemu_dmabuf_get_x(buf) + qemu_dmabuf_get_width(buf) > qemu_dmabuf_get_backing_width(buf) ||
+        (uint64_t)qemu_dmabuf_get_y(buf) + qemu_dmabuf_get_height(buf) > qemu_dmabuf_get_backing_height(buf) ||
+        !dbus_gl_context_bind(&scope)) {
+        return false;
+    }
+    glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &previous_read);
+    glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &previous_draw);
+    glGetIntegerv(GL_VIEWPORT, viewport);
+    glGetIntegerv(GL_TEXTURE_BINDING_2D, &previous_texture);
+    GLboolean scissor = glIsEnabled(GL_SCISSOR_TEST);
+    glDisable(GL_SCISSOR_TEST);
+    egl_dmabuf_import_texture(buf);
+    GLuint texture = qemu_dmabuf_get_texture(buf);
+    ok = texture && glGetError() == GL_NO_ERROR;
+    if (ok) {
+        egl_fb_setup_for_tex(&src, qemu_dmabuf_get_backing_width(buf),
+                            qemu_dmabuf_get_backing_height(buf), texture, false);
+        src.dmabuf = buf;
+        ok = glCheckFramebufferStatus(GL_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE;
+    }
+    if (ok) {
+        egl_fb_setup_new_tex(&dst, surface_width(ddl->vk_surface),
+                            surface_height(ddl->vk_surface));
+        ok = glCheckFramebufferStatus(GL_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE;
+    }
+    if (ok) {
+        egl_fb_blit(&dst, &src, qemu_dmabuf_get_y0_top(buf));
+        egl_fb_read(ddl->vk_surface, &dst);
+        ok = glGetError() == GL_NO_ERROR;
+    }
+    egl_fb_destroy(&src);
+    egl_fb_destroy(&dst);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, previous_read);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, previous_draw);
+    glViewport(viewport[0], viewport[1], viewport[2], viewport[3]);
+    glBindTexture(GL_TEXTURE_2D, previous_texture);
+    if (scissor) { glEnable(GL_SCISSOR_TEST); }
+    return ok;
+}
