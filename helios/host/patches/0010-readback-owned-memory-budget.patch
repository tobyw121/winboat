+G_LOCK_DEFINE_STATIC(helios_budget_lock);
+static HeliosMemoryBudget helios_owned_memory;
+static uint64_t helios_memory_serial;
+static uint64_t helios_memory_rejected;
+static gsize helios_budget_initialized;
+static void helios_budget_initialize(void)
+{
+    if (g_once_init_enter(&helios_budget_initialized)) {
+        const char *text = g_getenv("HELIOS_READBACK_BUDGET_MIB");
+        if (text && *text) {
+            char *end;
+            uint64_t mib = g_ascii_strtoull(text, &end, 10);
+            if (*end || mib > 16384) {
+                error_report("vulkan-readback: invalid owned-memory budget; using 64 MiB");
+                mib = 64;
+            }
+            helios_owned_memory.limit = mib * 1048576;
+        }
+        g_once_init_leave(&helios_budget_initialized, 1);
+    }
+}
+static VkResult helios_allocate_owned(VkDevice device,
+    const VkMemoryAllocateInfo *info, VkDeviceMemory *memory, uint64_t *accounted)
+{
+    helios_budget_initialize();
+    G_LOCK(helios_budget_lock);
+    bool allowed = helios_budget_reserve(&helios_owned_memory, info->allocationSize);
+    uint64_t used = helios_owned_memory.used, limit = helios_owned_memory.limit;
+    if (!allowed) helios_memory_rejected++;
+    G_UNLOCK(helios_budget_lock);
+    if (!allowed) {
+        error_report("vulkan-readback: budget-rejected requested=%" PRIu64
+                     " owned=%" PRIu64 " limit=%" PRIu64,
+                     (uint64_t)info->allocationSize, used, limit);
+        return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+    }
+    VkResult result = vkAllocateMemory(device, info, NULL, memory);
+    if (result == VK_SUCCESS) {
+        *accounted = info->allocationSize;
+    } else {
+        G_LOCK(helios_budget_lock);
+        helios_budget_release(&helios_owned_memory, info->allocationSize);
+        G_UNLOCK(helios_budget_lock);
+    }
+    return result;
+}
