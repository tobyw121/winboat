+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef HELIOS_MEMORY_BUDGET_H
+#define HELIOS_MEMORY_BUDGET_H
+#include <stdbool.h>
+#include <stdint.h>
+typedef struct HeliosMemoryBudget { uint64_t used, peak, limit; } HeliosMemoryBudget;
+static inline bool helios_budget_reserve(HeliosMemoryBudget *b, uint64_t bytes)
+{
+    if (bytes > UINT64_MAX-b->used || (b->limit && (b->used>b->limit || bytes > b->limit-b->used))) return false;
+    b->used += bytes;
+    if (b->used>b->peak) b->peak=b->used;
+    return true;
+}
+static inline bool helios_budget_release(HeliosMemoryBudget *b, uint64_t bytes)
+{
+    if (bytes>b->used) return false;
+    b->used-=bytes;
+    return true;
+}
+#endif
