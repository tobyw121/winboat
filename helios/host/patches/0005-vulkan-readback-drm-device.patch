+/* Select the Vulkan device belonging to the EGL render node, never by vendor.
+ * An opaque DMA-BUF import must not guess another GPU's image/memory layout. */
+static int helios_vulkan_readback_device_index(VkPhysicalDevice *devices,
+                                               uint32_t count)
+{
+    int render_fd = -1;
+    struct stat st;
+    HeliosDrmDeviceId *ids;
+    int selected;
+#ifdef CONFIG_GBM
+    render_fd = qemu_egl_rn_fd;
+#endif
+    if (render_fd < 0 || fstat(render_fd, &st) < 0 || !S_ISCHR(st.st_mode)) {
+        error_report("vulkan-readback: cannot identify EGL DRM render node");
+        return -1;
+    }
+    ids = g_new0(HeliosDrmDeviceId, count);
+    for (uint32_t i = 0; i < count; i++) {
+        uint32_t extension_count = 0;
+        VkExtensionProperties *extensions;
+        bool has_drm = false;
+        if (vkEnumerateDeviceExtensionProperties(devices[i], NULL,
+                &extension_count, NULL) != VK_SUCCESS || !extension_count) {
+            continue;
+        }
+        extensions = g_new0(VkExtensionProperties, extension_count);
+        if (vkEnumerateDeviceExtensionProperties(devices[i], NULL,
+                &extension_count, extensions) == VK_SUCCESS) {
+            for (uint32_t j = 0; j < extension_count; j++) {
+                if (!strcmp(extensions[j].extensionName,
+                            VK_EXT_PHYSICAL_DEVICE_DRM_EXTENSION_NAME)) {
+                    has_drm = true;
+                    break;
+                }
+            }
+        }
+        g_free(extensions);
+        if (has_drm) {
+            VkPhysicalDeviceDrmPropertiesEXT drm = {
+                .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DRM_PROPERTIES_EXT,
+            };
+            VkPhysicalDeviceProperties2 properties = {
+                .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2,
+                .pNext = &drm,
+            };
+            vkGetPhysicalDeviceProperties2(devices[i], &properties);
+            ids[i].has_render = drm.hasRender;
+            ids[i].render_major = drm.renderMajor;
+            ids[i].render_minor = drm.renderMinor;
+        }
+    }
+    selected = helios_vulkan_device_index(ids, count,
+                                         major(st.st_rdev), minor(st.st_rdev));
+    g_free(ids);
+    if (selected < 0) {
+        error_report("vulkan-readback: no unique Vulkan device matches DRM "
+                     "render node %u:%u", major(st.st_rdev), minor(st.st_rdev));
+    }
+    return selected;
+}
 
