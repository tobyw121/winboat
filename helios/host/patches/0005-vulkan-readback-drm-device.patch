@@ -0,0 +1,31 @@
+/* Pure selection rule shared by production readback and its regression test. */
+#ifndef HELIOS_VULKAN_DEVICE_SELECT_H
+#define HELIOS_VULKAN_DEVICE_SELECT_H
+#include <stdbool.h>
+#include <stdint.h>
+
+typedef struct HeliosDrmDeviceId {
+    bool has_render;
+    int64_t render_major;
+    int64_t render_minor;
+} HeliosDrmDeviceId;
+
+static inline int helios_vulkan_device_index(const HeliosDrmDeviceId *ids,
+    uint32_t count, uint32_t render_major, uint32_t render_minor)
+{
+    int selected = -1;
+    if (!ids || count > INT32_MAX) {
+        return -1;
+    }
+    for (uint32_t i = 0; i < count; i++) {
+        if (ids[i].has_render && ids[i].render_major == render_major &&
+            ids[i].render_minor == render_minor) {
+            if (selected >= 0) {
+                return -1; /* ambiguous identity is not permission to guess */
+            }
+            selected = (int)i;
+        }
+    }
+    return selected;
+}
+#endif
