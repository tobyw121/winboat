+
+static void
+helios_log_rejected_feature(struct vk_physical_device *physical_device,
+                           const char *structure, const char *field)
+{
+   vk_loge(VK_LOG_OBJS(physical_device), "%s.%s not supported", structure, field);
+#if defined(_WIN32) && defined(HELIOS_PRODUCT_NAME)
+   const char *root = getenv("LOCALAPPDATA");
+   char path[1024];
+   if (!root)
+      return;
+   int n = snprintf(path, sizeof(path), "%s/helios-vulkan-features.log", root);
+   if (n < 0 || (size_t)n >= sizeof(path))
+      return;
+   FILE *file = fopen(path, "a");
+   if (file) {
+      fprintf(file, "pid=%d %s.%s not supported\\n", _getpid(), structure, field);
+      fclose(file);
+   }
+#endif
+}
